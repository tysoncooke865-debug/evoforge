# Copy to .env.local (gitignored) and fill in from the Supabase dashboard.
# These are EXPO_PUBLIC_: they compile into the client bundle. That is what the
# publishable key is for -- RLS is the guard, not key secrecy. The SECRET key
# and OPENAI_API_KEY must never appear here or in any EXPO_PUBLIC_ var; AI calls
# go through Supabase Edge Functions (MIGRATION_PLAN "AI via Edge Functions").
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# ERROR MONITORING (WO-005). A Sentry DSN is a PUBLIC, WRITE-ONLY key: it can
# submit events and read nothing, which is why it is allowed to be EXPO_PUBLIC_
# and ship in the bundle. The Sentry AUTH TOKEN, which can read your data, is an
# edge-function secret and must never appear here. Leave blank and monitoring
# stays OFF -- nothing is queued and nothing pretends to be watching.
# See docs/ERROR_MONITORING.md.
EXPO_PUBLIC_SENTRY_DSN=
# Optional. Web takes its release from the hashed entry bundle automatically;
# set this only for a native build, which has no such hash.
EXPO_PUBLIC_SENTRY_RELEASE=
