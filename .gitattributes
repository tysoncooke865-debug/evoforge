# Normalise line endings on commit; check out native in the working copy.
* text=auto

# The parity goldens are a byte-exact contract between Python and TypeScript.
# `tools/gen_fixtures.py --check` normalises on read, so a CRLF working copy does
# not break it -- but the committed blob must be LF on every platform, or a diff
# between two developers' checkouts says "drift" when nothing drifted.
contracts/fixtures/*.json text eol=lf

# Avatar art is binary. Never touch it.
*.png binary

# gen-exercise-ids.mjs is regexed byte-for-byte by exercise-identity.test.ts; a
# CRLF checkout (Windows autocrlf) fails that test while git reports the file
# clean. Pin LF in the working copy on every platform.
client/scripts/gen-exercise-ids.mjs text eol=lf

# The lab-sync fork-recipe patches are byte-sensitive the same way: git apply
# needs patch and target to agree, and the target is LF-normalized in memory.
# A CRLF checkout would fail every hunk while git reports the files clean.
client/scripts/lab-sync/*.patch text eol=lf

